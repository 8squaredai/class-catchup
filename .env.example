# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://nendnnxipxsnispborob.supabase.co
# safe to expose (RLS blocks table access)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PCQyWQHELj8wLQFKiLBUZQ_olQXAY1d
# or the legacy service_role key
SUPABASE_SECRET_KEY=sb_secret_xxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-5-5

# ElevenLabs (Scribe speech-to-text)
ELEVENLABS_API_KEY=sk_xxx

# Telegram bot (the live channel). Token from @BotFather; the secret is any random string you choose
# (letters, digits, _ and -). Set both here AND in Vercel, then run: npm run telegram:setup -- <public url>
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
TELEGRAM_WEBHOOK_SECRET=some-long-random-string
TELEGRAM_BOT_USERNAME=YourBotName

# Optional second channel: Twilio WhatsApp Sandbox (needs an upgraded Twilio account to receive messages) (Console → Messaging → Try it out → Send a WhatsApp message)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN=join your-two-words     # shown in the console; used in help text

# Public URL Twilio posts to (your ngrok/cloudflared URL locally, your Vercel URL in prod).
# Must match exactly what is configured in the Twilio console, or signature checks fail.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Password for /admin (username can be anything)
ADMIN_PASSWORD=change-me

# Local only: skip Twilio signature validation while debugging (never in production)
TWILIO_SKIP_SIGNATURE=false
